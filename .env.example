# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).

# Public address people and agents use. Must be https:// in production.
PUBLIC_URL=https://mcp.example.com
# Used by the optional Caddy service for automatic HTTPS.
COLLAB_DOMAIN=mcp.example.com
SERVER_NAME=Sailing Team

# openssl rand -hex 32
SECRET_KEY=
# openssl rand -hex 24
POSTGRES_PASSWORD=

# GitHub accounts that become admins on their first GitHub login (comma separated).
ADMIN_GITHUB_LOGINS=your-github-login

# GitHub OAuth app (login): https://github.com/settings/developers → New OAuth App
#   Homepage URL:  https://mcp.example.com
#   Callback URL:  https://mcp.example.com/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# GitHub API token for commits, PRs and issues (fine-grained PAT: Contents read, Issues read/write,
# Pull requests read, Metadata read – on your project repositories only).
GITHUB_TOKEN=

# Webhook secret (openssl rand -hex 20); same value in the GitHub webhook settings.
GITHUB_WEBHOOK_SECRET=

# Optional: Discord channel for blockers, broken builds, handoffs, direct messages and the weekly digest.
# Projects can also set their own webhook in the dashboard (stored encrypted).
DISCORD_WEBHOOK_URL=
# Weekly digest: day (0 Sun … 6 Sat, -1 off) and hour (server time; set TZ=Europe/Berlin etc.)
# DIGEST_WEEKDAY=1
# DIGEST_HOUR=9

# Any secret can instead be read from a file: SECRET_KEY_FILE=/run/secrets/secret_key

# Timing (defaults shown)
# AGENT_OFFLINE_AFTER=15m
# RESERVATION_GRACE=45m
# RESERVATION_DEFAULT_TTL=4h
# RESERVATION_MAX_TTL=72h
# MESSAGE_RATE_LIMIT=20
# SESSION_TTL=30d
# LOG_LEVEL=info
